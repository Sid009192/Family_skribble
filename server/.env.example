# Copy this file to ".env" and fill in real values.
# The real .env is git-ignored and never shipped to the browser.

# The secret that unlocks your Super-Admin (godmode) powers.
# Pick something long and not guessable.
ADMIN_KEY=change-me-to-a-long-secret

# Port the server listens on.
PORT=3001

# The client's dev URL, allowed to connect (CORS). Vite default is 5173.
CLIENT_ORIGIN=http://localhost:5173
